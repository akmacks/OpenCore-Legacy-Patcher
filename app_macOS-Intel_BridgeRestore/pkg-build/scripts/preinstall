#!/bin/bash
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  preinstall  — Bridge Restore pkg installer                             ║
# ║  Runs as root before payload is laid down.                              ║
# ║  Detects existing installation, asks user to archive/overwrite/cancel.  ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Detect the installing user (running as root in macOS Installer)
INSTALL_USER=$(stat -f "%Su" /dev/console 2>/dev/null || \
               who | awk '/console/{print $1}' | head -1)
[[ -z "$INSTALL_USER" ]] && INSTALL_USER="$USER"
USER_HOME=$(eval echo "~$INSTALL_USER")

APP_SUPPORT="$USER_HOME/Library/Application Support/BridgeRestore"
ARCHIVES="$APP_SUPPORT/archives"
VERSION_FILE="$APP_SUPPORT/VERSION"
NEW_VERSION="1.0.2-alpha"
APP_BUNDLE="/Applications/BridgeRestore.app"
BIN="/usr/local/bin/bridge-restore"

mkdir -p "$ARCHIVES" "$APP_SUPPORT"

osac() { sudo -u "$INSTALL_USER" osascript -e "$1" 2>/dev/null; }

log() { echo "[preinstall] $*" >> "$USER_HOME/logs/bridge-restore-install.log" 2>/dev/null || true; }
mkdir -p "$USER_HOME/logs"
log "=== preinstall starting | new_version=$NEW_VERSION | user=$INSTALL_USER ==="

# ── Detect existing installation ──────────────────────────────────────────────
EXISTING_VERSION=""
if [[ -f "$VERSION_FILE" ]]; then
  EXISTING_VERSION=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]')
elif [[ -f "$BIN" ]]; then
  EXISTING_VERSION=$(grep -m1 'VERSION=' "$BIN" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
fi

if [[ -z "$EXISTING_VERSION" ]] && [[ ! -d "$APP_SUPPORT/scripts" ]]; then
  log "No existing installation — proceeding with fresh install"
  exit 0
fi

# ── Existing installation found — ask user ────────────────────────────────────
log "Existing version detected: $EXISTING_VERSION"
TS=$(date '+%Y%m%d-%H%M%S')
ARCHIVE_NAME="BridgeRestore-${EXISTING_VERSION:-unknown}-$TS.zip"
ARCHIVE_PATH="$ARCHIVES/$ARCHIVE_NAME"

CHOICE=$(sudo -u "$INSTALL_USER" osascript << AS 2>/dev/null
set t to "Bridge Restore — Installer"
set msg to "Bridge Restore is already installed.

Installed version: ${EXISTING_VERSION:-unknown}
New version:       $NEW_VERSION

What would you like to do?"
set r to button returned of (display dialog msg ¬
  buttons {"Cancel", "Archive & Install", "Install Over Existing"} ¬
  default button "Archive & Install" cancel button "Cancel" ¬
  with title t with icon note)
return r
AS
) || { log "User cancelled"; exit 1; }

log "User chose: $CHOICE"

case "$CHOICE" in
  "Cancel")
    log "Installation cancelled by user"
    exit 1
    ;;

  "Archive & Install")
    log "Archiving existing installation to $ARCHIVE_PATH"
    # Zip scripts + config
    ITEMS=()
    [[ -d "$APP_SUPPORT/scripts" ]]  && ITEMS+=("$APP_SUPPORT/scripts")
    [[ -f "$APP_SUPPORT/VERSION" ]]  && ITEMS+=("$APP_SUPPORT/VERSION")
    [[ -d "$APP_BUNDLE" ]]           && ITEMS+=("$APP_BUNDLE")
    if [[ ${#ITEMS[@]} -gt 0 ]]; then
      mkdir -p "$ARCHIVES"
      zip -qry "$ARCHIVE_PATH" "${ITEMS[@]}" 2>/dev/null && {
        log "Archive created: $ARCHIVE_PATH ($(du -sh "$ARCHIVE_PATH" | cut -f1))"
        sudo -u "$INSTALL_USER" osascript -e "display notification \"Previous version archived to: $ARCHIVE_NAME\" with title \"Bridge Restore\"" 2>/dev/null
      } || log "WARN: Archive creation failed"
    fi
    # Remove old app bundle (will be replaced by payload)
    [[ -d "$APP_BUNDLE" ]] && rm -rf "$APP_BUNDLE" && log "Removed old app bundle"
    ;;

  "Install Over Existing")
    log "Installing over existing version — no archive"
    [[ -d "$APP_BUNDLE" ]] && rm -rf "$APP_BUNDLE" && log "Removed old app bundle for replacement"
    ;;
esac

log "=== preinstall complete ==="
exit 0
