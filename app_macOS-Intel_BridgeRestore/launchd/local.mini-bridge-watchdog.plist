<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.mini-bridge-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/akmacks/scripts/mini-bridge-watchdog.sh</string>
    </array>

    <!-- Run every 30 seconds — matches MBP mbp-tb-restore cadence -->
    <key>StartInterval</key>
    <integer>30</integer>

    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/akmacks/Library/Logs/BridgeRestore/mini-watchdog-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/akmacks/Library/Logs/BridgeRestore/mini-watchdog-launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/akmacks</string>
    </dict>
</dict>
</plist>
