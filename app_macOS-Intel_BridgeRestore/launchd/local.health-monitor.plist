<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.health-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/usr/local/bin/health-monitor</string>
  </array>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/akmacks/Library/Logs/BridgeRestore/health-monitor.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/akmacks/Library/Logs/BridgeRestore/health-monitor.err</string>
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
